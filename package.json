{
  "name": "pii-review-assistant",
  "version": "2.1.0",
  "private": true,
  "description": "Chrome extension that helps reviewers check PII labels on Peak Talent. No runtime dependencies.",
  "scripts": {
    "test": "node --test 'tests/*.test.js'",
    "build": "node scripts/build.js",
    "check": "node scripts/build.js --check",
    "bench": "node tests/bench.js 5000",
    "sweep": "node tests/sweep.js",
    "setup-model": "node scripts/setup-model.js",
    "build:model": "node scripts/build.js --with-model",
    "build-kb": "node scripts/build-kb.js",
    "score": "node ml/score.js",
    "reports": "node ml/reports.js",
    "release": "node scripts/release.js",
    "build-names": "node scripts/build-names.js",
    "label-bench": "node ml/label-bench.js"
  },
  "engines": {
    "node": ">=22"
  },
  "piira": {
    "releaseRepos": [
      "kylashreddy/PII-Review-Assistant-Extension",
      "kylashreddy/PII-extension-Testing"
    ]
  }
}
